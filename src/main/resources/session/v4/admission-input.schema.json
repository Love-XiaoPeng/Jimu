{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:session-search:1:admission",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "history_session_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    }
  },
  "required": [
    "goal",
    "history_session_ids"
  ]
}
