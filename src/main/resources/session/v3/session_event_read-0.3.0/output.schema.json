                          "type": "string",
                          "maxLength": 2048
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "name",
                        "arguments"
                      ],
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "name": {
                                "const": "session_event_read"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "arguments": {
                                "type": "string",
                                "maxLength": 1024
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "name": {
                                "const": "session_event_trace"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "arguments": {
                                "type": "string",
                                "maxLength": 1024
                              }
                            }
                          }
                        }
                      ]
                    }
