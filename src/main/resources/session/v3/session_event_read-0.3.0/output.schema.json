                "required": [
                  "seq",
                  "before",
                  "after",
                  "upper_seq",
                  "outcome",
                  "code",
                  "output_sha256",
                  "output_bytes"
                ]
              },
              "source": {
                "properties": {
                  "kind": {
                    "const": "invocation"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "turn.ended"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "state": {
                    "enum": [
                      "SUCCEEDED",
                      "FAILED",
                      "CANCELLED",
                      "NEEDS_RECONCILIATION"
                    ]
                  },
                  "code": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 64
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "state",
                  "code"
                ]
              },
              "source": {
                "properties": {
                  "kind": {
                    "const": "task"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "session.read"
              },
              "data": {
                "properties": {
                  "outcome": {
                    "const": "SUCCEEDED"
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "source_event_seqs": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "source_event_seqs": {
                "maxItems": 0
              }
            }
          }
        }
      ]
