                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  "outcome": {
                    "enum": [
                      "SUCCEEDED",
                      "FAILED"
                    ]
                  },
                  "code": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "output_sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "output_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32768
                  }
