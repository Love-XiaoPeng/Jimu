        {
          "if": {
            "properties": {
              "type": {
                "const": "session.read"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "seq": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
