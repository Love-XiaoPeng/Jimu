{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:session-event-read:0.1.0:context-v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "session_event_context"
    },
    "version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "upper_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127
    },
    "user_message_seq": {
      "const": 0
    },
    "recent": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "type": {
            "enum": [
              "user.message",
              "step.started",
              "model.response",
              "session.read",
              "turn.ended"
            ]
          }
        },
        "required": [
          "seq",
          "type"
        ]
      }
    }
  },
  "required": [
    "kind",
    "version",
    "session_id",
    "upper_seq",
    "user_message_seq",
    "recent"
  ]
}
