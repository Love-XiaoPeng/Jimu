{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:session-event-read:0.1.0:input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    }
  },
  "required": [
    "seq"
  ]
}
