{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:session:v5:genesis:0.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["version", "session_id", "kind", "created_at", "request_sha256", "authority_sha256", "binding_sha256"],
  "properties": {
    "version": {"const": 1},
    "session_id": {"$ref": "#/$defs/uuid"},
    "kind": {"enum": ["ROOT", "CONTINUATION"]},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "request_sha256": {"$ref": "#/$defs/hash"},
    "authority_sha256": {"$ref": "#/$defs/hash"},
    "binding_sha256": {"$ref": "#/$defs/hash"},
    "parent_session_id": {"$ref": "#/$defs/uuid"},
    "parent_genesis_sha256": {"$ref": "#/$defs/hash"}
  },
  "allOf": [{
    "if": {"properties": {"kind": {"const": "CONTINUATION"}}},
    "then": {"required": ["parent_session_id", "parent_genesis_sha256"]},
    "else": {"not": {"anyOf": [{"required": ["parent_session_id"]}, {"required": ["parent_genesis_sha256"]}]}}
  }],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$comment": "Insert-only host fact; <=1024 UTF8 bytes. Check exact admission request, scope digest, binding and actual parent genesis; model assertions and matching owner do not create lineage."
}
