{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:session:v5:graph:0.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["version", "caller_session_id", "authority_sha256", "nodes"],
  "properties": {
    "version": {"const": 1},
    "caller_session_id": {"$ref": "#/$defs/uuid"},
    "authority_sha256": {"$ref": "#/$defs/hash"},
    "nodes": {
      "type": "array", "minItems": 1, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["session_id", "genesis_snapshot", "genesis_sha256"],
        "properties": {
          "session_id": {"$ref": "#/$defs/uuid"},
          "genesis_snapshot": {"type": "string", "minLength": 1, "maxLength": 1024},
          "genesis_sha256": {"$ref": "#/$defs/hash"}
        }
      }
    }
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$comment": "<=16384 UTF8 bytes; nodes sorted by UUID, exact caller+explicit scope set; decode/validate each genesis once and verify stored original byte hash. Every parent and source dependency must stay in the authorized set. No recursive graph embedding."
}
