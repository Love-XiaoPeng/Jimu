{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:plugin:workspace-grep:0.1.0:input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pattern"
  ],
  "properties": {
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "include": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "cursor": {
      "type": "string",
      "minLength": 22,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
