{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:plugin:workspace-grep:0.1.0:output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matches",
    "seen",
    "returned",
    "truncated",
    "nextCursor"
  ],
  "properties": {
    "matches": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "lineNumber",
          "line",
          "lineTruncated"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "lineNumber": {
            "type": "integer",
            "minimum": 1
          },
          "line": {
            "type": "string",
            "maxLength": 2017
          },
          "lineTruncated": {
            "type": "boolean"
          }
        }
      }
    },
    "seen": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "returned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "truncated": {
      "type": "boolean"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 22,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
