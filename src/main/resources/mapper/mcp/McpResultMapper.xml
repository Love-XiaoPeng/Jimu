<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.lovexiaopeng.jimu.adapters.persistence.mcp.mapper.McpResultMapper"><insert id="insertMcpResult"><![CDATA[INSERT INTO mcp_result(tenant_id,task_id,root_invocation_id,server,method,binding_digest,projection_digest,body,body_digest,byte_size,expires_at,state) VALUES(#{tenant},#{task},#{invocation},#{server},#{method},#{binding},#{projection},#{body},#{digest},#{size},TIMESTAMPADD(DAY,7,CURRENT_TIMESTAMP(6)),'RETAINED')]]></insert>
</mapper>
