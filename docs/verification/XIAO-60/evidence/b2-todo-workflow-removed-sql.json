      "result": "List<Row>",
      "original": "SELECT i.*,s.state AS step_state,s.record_version AS step_version,s.response_snapshot,s.response_digest,s.task_id AS step_task FROM invocation i JOIN step s ON s.tenant_id=i.tenant_id AND s.id=i.step_id WHERE i.tenant_id=? AND i.task_id=? AND i.step_id=? AND i.slot=? FOR UPDATE",
      "sql": "SELECT i.tenant_id,i.id,i.task_id,i.step_id,i.attempt_id,i.ordinal,i.slot,i.provider_id,i.effect_intent_id,i.tool,i.plugin_version,i.plugin_digest,i.installation_epoch,i.input_snapshot,i.input_digest,i.state,i.output_snapshot,i.output_digest,i.projection_version,i.updated_at,i.record_version,i.todo_expected_revision,i.todo_applied_revision,i.todo_committed_attempt_id,i.todo_committed_fence,i.todo_event_seq,i.todo_committed_at,s.state AS step_state,s.record_version AS step_version,s.response_snapshot,s.response_digest,s.task_id AS step_task FROM invocation i JOIN step s ON s.tenant_id=i.tenant_id AND s.id=i.step_id WHERE i.tenant_id=#{tenant} AND i.task_id=#{task} AND i.step_id=#{step} AND i.slot=#{slot} FOR UPDATE",
