      "original": "SELECT t.next_event_seq,p.*,i.id AS invocation_id,i.task_id AS invocation_task,i.step_id AS invocation_step,i.attempt_id,i.provider_id,i.tool,i.state AS state,i.todo_expected_revision,i.todo_applied_revision,i.todo_committed_attempt_id,i.todo_committed_fence,i.todo_event_seq,i.todo_committed_at,i.output_snapshot,i.output_digest AS invocation_digest FROM task t LEFT JOIN task_todo_projection p ON p.tenant_id=t.tenant_id AND p.task_id=t.id LEFT JOIN invocation i ON i.tenant_id=p.tenant_id AND i.id=p.source_invocation_id WHERE t.tenant_id=? AND t.id=? AND t.owner_actor_id=?",
      "sql": "SELECT t.next_event_seq,p.tenant_id,p.task_id,p.record_version,p.todo_version,p.binding_snapshot,p.binding_digest,p.revision,p.content_state,p.source_invocation_id,p.source_step_id,p.committed_attempt_id,p.committed_fence,p.updated_seq,p.pending_count,p.in_progress_count,p.completed_count,p.output_digest,p.updated_at,p.retain_until,p.reserved_bytes,p.retained_digests,i.id AS invocation_id,i.task_id AS invocation_task,i.step_id AS invocation_step,i.attempt_id,i.provider_id,i.tool,i.state AS state,i.todo_expected_revision,i.todo_applied_revision,i.todo_committed_attempt_id,i.todo_committed_fence,i.todo_event_seq,i.todo_committed_at,i.output_snapshot,i.output_digest AS invocation_digest FROM task t LEFT JOIN task_todo_projection p ON p.tenant_id=t.tenant_id AND p.task_id=t.id LEFT JOIN invocation i ON i.tenant_id=p.tenant_id AND i.id=p.source_invocation_id WHERE t.tenant_id=#{tenant} AND t.id=#{task} AND t.owner_actor_id=#{actor}",
      "select": true
    }
  ]
