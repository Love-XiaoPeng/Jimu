{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:session-search:1:output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "caller_session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "scope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boundary": {
      "const": "scoped-admission"
    },
    "content_policy": {
      "const": "public-v1"
    },
    "match_policy": {
      "const": "public-content-literal-v1"
    },
    "ordering": {
      "const": "occurrences-desc,length-asc,time-desc,session-id-asc,seq-desc"
    },
    "returned_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "capped": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "created_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 32,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
            "description": "Host additionally validates Gregorian dates, offsets, inclusive UTC microsecond ranges and ordering."
          },
          "history_version": {
            "const": 4
          },
          "upper_seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "best_match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "type": {
                "enum": [
                  "user.message",
                  "model.response"
                ]
              },
              "time": {
                "type": "string",
                "minLength": 20,
                "maxLength": 32,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
                "description": "Host additionally validates Gregorian dates, offsets, inclusive UTC microsecond ranges and ordering."
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "request",
                      "step",
                      "model",
                      "invocation",
                      "task"
                    ]
                  },
                  "step_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "invocation_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "step_id",
                  "invocation_id"
                ]
              },
              "redacted": {
                "type": "boolean"
              },
              "event_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "snippet": {
                "type": "string",
                "maxLength": 240
              },
              "left_truncated": {
                "type": "boolean"
              },
              "right_truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "seq",
              "type",
              "time",
              "source",
              "redacted",
              "event_sha256",
              "snippet",
              "left_truncated",
              "right_truncated"
            ]
          }
        },
        "required": [
          "session_id",
          "created_at",
          "history_version",
          "upper_seq",
          "best_match"
        ]
      }
    }
  },
  "required": [
    "version",
    "caller_session_id",
    "scope_sha256",
    "boundary",
    "content_policy",
    "match_policy",
    "ordering",
    "returned_count",
    "capped",
    "items"
  ]
}
