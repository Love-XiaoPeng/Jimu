{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "model-snapshot-v3-image-input-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "enabled",
    "mediaTypes",
    "maxImages",
    "maxImageBytes",
    "maxTotalImageBytes",
    "maxRequestBytes",
    "evidence"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "mediaTypes": {
      "const": [
        "image/png"
      ]
    },
    "maxImages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "maxImageBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "maxTotalImageBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "maxRequestBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
