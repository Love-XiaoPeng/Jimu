{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "optional-task-images-field-v1",
  "description": "Schema for the optional images field only; not a replacement for the existing task submission schema. Missing field retains the legacy request codec.",
  "type": "array",
  "minItems": 1,
  "maxItems": 4,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "filePath",
      "dataBase64"
    ],
    "properties": {
      "filePath": {
        "type": "string",
        "minLength": 15,
        "maxLength": 512,
        "pattern": "^inputs/images/"
      },
      "dataBase64": {
        "type": "string",
        "minLength": 4,
        "maxLength": 1398104,
        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
      }
    }
  }
}
