{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:plugin:mcp.list-resources:0.1.0:input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server"
  ],
  "properties": {
    "server": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    }
  }
}
