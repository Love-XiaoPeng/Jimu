{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:mcp:list-snapshot:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tenant",
    "owner",
    "taskId",
    "rootInvocation",
    "server",
    "method",
    "bindingDigest",
    "queryDigest",
    "projectionDigest",
    "pages",
    "cursorPositions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "rootInvocation": {
      "type": "string",
      "format": "uuid"
    },
    "server": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "method": {
      "enum": [
        "resources/list",
        "resources/templates/list"
      ]
    },
    "bindingDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "queryDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectionDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 65536
      }
    },
    "cursorPositions": {
      "type": "object",
      "maxProperties": 999,
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 999
      }
    }
  }
}
