{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:interaction:ask-user:0.2.0:output",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$"
              },
              "selected": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "minItems": 0,
                "maxItems": 8,
                "uniqueItems": true
              },
              "custom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "id",
              "selected"
            ]
          },
          "minItems": 1,
          "maxItems": 4
        }
      },
      "required": [
        "answers"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pending": {
          "const": true
        },
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "const": "No answer batch arrived before the timeout. This is pending, not a skipped answer. Continue useful independent work. The user can still answer; their reply will be a user message identified as answer_to_pending_question with this callId and the original questions. Do not treat this as permission."
        }
      },
      "required": [
        "pending",
        "callId",
        "message"
      ]
    }
  ]
}
