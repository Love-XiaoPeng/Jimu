{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:interaction:ask-user:0.1.0:output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "selected": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 0,
            "maxItems": 8,
            "uniqueItems": true
          },
          "custom": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "id",
          "selected"
        ]
      },
      "minItems": 1,
      "maxItems": 4
    }
  },
  "required": [
    "answers"
  ]
}
